{
  "name": "stutter-tracker-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:local": "bun scripts/dev.ts",
    "web": "bun run dev:web",
    "server": "bun run dev:server",
    "desktop": "bun run dev:desktop",
    "mobile": "bun run start:mobile",
    "dev:web": "bun --filter @stutter-tracker/web dev",
    "dev:server": "bun --filter @stutter-tracker/server dev",
    "dev:desktop": "bun --filter @stutter-tracker/desktop dev",
    "start": "bun run dev",
    "start:web": "bun --filter @stutter-tracker/web start",
    "start:server": "bun --filter @stutter-tracker/server start",
    "start:desktop": "bun --filter @stutter-tracker/desktop start",
    "start:mobile": "bun --filter @stutter-tracker/mobile start",
    "artifacts:status": "cargo run --manifest-path apps/desktop/src-tauri/Cargo.toml --bin ensure-artifacts -- --list",
    "artifacts:download": "cargo run --manifest-path apps/desktop/src-tauri/Cargo.toml --bin ensure-artifacts --",
    "artifacts:download:all": "cargo run --manifest-path apps/desktop/src-tauri/Cargo.toml --bin ensure-artifacts -- --all",
    "benchmark:youtube": "bun scripts/benchmark-youtube.ts",
    "benchmark:stutter": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml stutter_bench -- --nocapture",
    "benchmark:stutter:corpus": "cargo run --release --manifest-path apps/desktop/src-tauri/Cargo.toml --bin stutter-eval --",
    "transcribe:youtube": "python3 scripts/transcribe-youtube.py",
    "transcribe:youtube:cuda": "python3 scripts/transcribe-youtube.py --device cuda --compute-type float16",
    "build": "turbo run build",
    "build:apps": "turbo run build --filter=./apps/*",
    "build:packages": "turbo run build --filter=./packages/*",
    "build:shared": "turbo run build --filter=@stutter-tracker/shared --filter=@stutter-tracker/compute-client",
    "build:web": "turbo run build --filter=@stutter-tracker/web",
    "build:server": "turbo run build --filter=@stutter-tracker/server",
    "build:desktop": "turbo run build --filter=@stutter-tracker/desktop",
    "build:mobile": "turbo run build --filter=@stutter-tracker/mobile",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run build && bun run test",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "lint": "bunx oxlint@1.80.0 apps packages scripts --format=github",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p apps/server/tsconfig.json && tsc --noEmit -p apps/mobile/tsconfig.json && tsc --noEmit -p packages/compute-client/tsconfig.json && tsc --noEmit -p packages/shared/tsconfig.json",
    "test": "turbo run test",
    "test:web": "turbo run test --filter=@stutter-tracker/web",
    "test:server": "turbo run test --filter=@stutter-tracker/server",
    "test:desktop": "turbo run test --filter=@stutter-tracker/desktop",
    "test:compute-client": "turbo run test --filter=@stutter-tracker/compute-client",
    "test:mobile": "turbo run test --filter=@stutter-tracker/mobile",
    "test:unit": "turbo run test:unit --filter=@stutter-tracker/web",
    "test:integration": "turbo run test:integration --filter=@stutter-tracker/web",
    "test:e2e": "turbo run test:e2e --filter=@stutter-tracker/web",
    "test:rust": "turbo run test --filter=@stutter-tracker/desktop"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/bun": "1.4.3",
    "@types/node": "25.9.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "29.1.1",
    "oxfmt": "0.74.0",
    "turbo": "2.11.9",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "trustedDependencies": [
    "@moritzbrantner/audio-analysis-core-wasm"
  ],
  "packageManager": "bun@1.4.3"
}
