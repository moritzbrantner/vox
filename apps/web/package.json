{
  "name": "@stutter-tracker/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "start": "vite preview --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "format": "oxfmt --write \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" vite.config.ts playwright.config.ts",
    "format:check": "oxfmt --check \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" vite.config.ts playwright.config.ts",
    "lint": "bunx oxlint@1.80.0 src tests vite.config.ts playwright.config.ts --format=github",
    "typecheck": "tsc --noEmit",
    "test": "bun run test:unit && bun run test:integration && bun run test:e2e",
    "test:unit": "vitest run src/App.unit.test.ts src/audio/*.test.ts src/recording/*.test.ts src/storage/*.test.ts",
    "test:integration": "vitest run src/App.integration.test.tsx src/SessionPersistence.integration.test.tsx src/AuditoryFeedbackLab.integration.test.tsx src/OfflineModelPreparation.integration.test.tsx src/SessionDeletion.integration.test.tsx src/SessionRestore.integration.test.tsx src/SessionMutationLock.integration.test.tsx",
    "test:e2e": "playwright test",
    "bench:pitch-worklet": "bun scripts/bench-pitch-worklet.ts"
  },
  "dependencies": {
    "@moritzbrantner/audio-analysis-core-wasm": "github:moritzbrantner/audio-analysis-core-wasm#195e5bb93b599163738acf682bfb26fa0e07645b",
    "@stutter-tracker/compute-client": "workspace:*",
    "@stutter-tracker/shared": "workspace:*",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.100.11",
    "@tauri-apps/api": "^2.10.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.51.0",
    "typescript": "~5.8.3",
    "vite": "^7.3.2",
    "vitest": "^4.1.6"
  }
}
