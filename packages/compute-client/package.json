{
  "name": "@stutter-tracker/compute-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "bunx oxlint@1.80.0 src --format=github",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "oxfmt --write \"src/**/*.{ts,tsx}\"",
    "format:check": "oxfmt --check \"src/**/*.{ts,tsx}\"",
    "test": "bun test src/index.test.ts"
  },
  "dependencies": {
    "@stutter-tracker/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
