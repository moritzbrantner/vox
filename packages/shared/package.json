{
  "name": "@stutter-tracker/shared",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "bunx oxlint@1.80.0 src --format=github",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun run test:unit",
    "test:unit": "bun test src",
    "bench:audio-fingerprint": "bun scripts/bench-audio-fingerprint.ts",
    "format": "oxfmt --write \"src/**/*.{ts,tsx}\"",
    "format:check": "oxfmt --check \"src/**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
